DRIVER=~fastapi+~httpx+~aiohttp
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# Token、Webhook key 等敏感配置请写在 .env.prod（已 gitignore），NoneBot 会自动叠加加载

# MCP Server：Grok Bot 通过 http(s)://<host>/grok_bot/mcp 访问，可走 Tailscale
GROK_BOT_MCP_PREFIX=/grok_bot
GROK_BOT_MCP_TOKEN=

# 白名单：私聊只接受 Owner 和 ALLOWED_USERS，群聊只接受 ALLOWED_GROUPS
GROK_BOT_OWNERS=[]
GROK_BOT_ALLOWED_USERS=[]
GROK_BOT_ALLOWED_GROUPS=[]
# 路由：按会话匹配，推送到对应 Grok Bot Routine 的 Webhook
# 例：GROK_BOT_ROUTES='[{"name": "main", "sessions": ["private:*"], "webhook_url": "https://api2.cursor.sh/automations/webhook/<id>", "webhook_key": "crsr_xxx", "owner_trigger": "always"}, {"name": "groups", "sessions": ["group:*"], "webhook_url": "...", "webhook_key": "...", "flush_interval": 300, "flush_size": 30}]'
GROK_BOT_ROUTES=[]
